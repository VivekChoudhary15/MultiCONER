{
  "data": {
    "data_root": "/DATA/MultiCONER/dataset/multiconer2023",
    "language": "EN-English",
    "train_splits": [
      "train"
    ],
    "val_split": "dev",
    "test_split": "test",
    "max_length": 256,
    "lowercase": false,
    "multilingual": false
  },
  "model": {
    "model_name": "xlm-roberta-large",
    "use_crf": true,
    "classifier_dropout": 0.1,
    "freeze_backbone": false
  },
  "train": {
    "seed": 42,
    "train_batch_size": 16,
    "val_batch_size": 32,
    "learning_rate": 1e-05,
    "weight_decay": 0.01,
    "num_train_epochs": 5,
    "warmup_ratio": 0.1,
    "max_grad_norm": 1.0,
    "log_every": 50,
    "eval_every": 500,
    "early_stopping_patience": 3,
    "fp16": true,
    "language_sampling_temperature": 1.0
  },
  "log": {
    "tb_dir": "/DATA/MultiCONER/runs",
    "output_dir": "/DATA/MultiCONER/models",
    "predictions_dir": "/DATA/MultiCONER/outputs",
    "experiment_name": "multiconer_ner",
    "save_every_epoch": true,
    "save_best_model": true
  }
}